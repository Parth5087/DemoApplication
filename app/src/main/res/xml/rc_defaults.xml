<?xml version="1.0" encoding="utf-8"?>
<defaultsMap>
    <!-- Capture cadence -->
    <entry key="capture_interval_sec" value="1" />

    <!-- Upload zip time -->
    <entry key="upload_interval_sec_photos" value="60" />

    <!-- Upload data time (1 hour = 3600 sec) -->
    <entry key="upload_interval_sec_data" value="3600" />

    <!-- Delete record time (1 minute) -->
    <entry key="delete_record_time" value="180" />

    <!-- Image processing knobs -->
    <entry key="jpeg_to_webp_quality" value="80" />
    <entry key="jpeg_to_webp_max_dim" value="1200" />

    <entry key="auto_upload_enabled" value="true" />
</defaultsMap>
